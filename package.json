{
  "name": "atlas-project-harness",
  "version": "0.1.0-beta.3",
  "description": "践行 Project Harness 的全流程 AI 编程工作流治理引擎",
  "bin": {
    "atlas": "bin/atlas.js"
  },
  "main": "./extensions/pi.ts",
  "exports": {
    ".": "./extensions/pi.ts",
    "./pi": "./extensions/pi.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/pi.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "bin",
    "extensions",
    "shared",
    "rings",
    "apply",
    "scripts",
    "templates",
    "adapters",
    "validators",
    "patches",
    "agents",
    "skills",
    "docs",
    "install.sh",
    "README.md",
    "DESIGN.md"
  ],
  "scripts": {
    "test": "pytest tests/",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "atlas",
    "vibecoding",
    "trellis",
    "workflow",
    "spec-driven",
    "e2e",
    "playwright"
  ],
  "author": "agent_learning",
  "license": "Apache-2.0"
}
