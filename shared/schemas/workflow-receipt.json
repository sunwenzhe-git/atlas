{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas:workflow-receipt:v1",
  "title": "Atlas workflow completion receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "unit", "task_id", "requirement_id", "clause_ids", "incident_ids", "resolves_incidents", "doc_ids", "topology_refs", "topology_required", "migration_required", "classification_required", "base", "diff_range", "staged_patch", "tree_hash", "semantic_expected_digest", "semantic_observed_digest", "semantic_graph_digest", "validators", "validator_evidence", "validator_code_sha256", "review", "origin", "in_scope_modules", "module_modes", "generated_at", "workflow_version"],
  "properties": {
    "schema_version": {"const": 1},
    "unit": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1},
    "requirement_id": {"type": ["string", "null"]}, "clause_ids": {"type": "array", "items": {"type": "string"}},
    "incident_ids": {"type": "array", "items": {"type": "string"}},
    "resolves_incidents": {"type": "array", "items": {"type": "string"}},
    "doc_ids": {"type": "array", "items": {"type": "string"}},
    "topology_refs": {"type": "array", "items": {"type": "string"}},
    "topology_required": {"type": "boolean"}, "migration_required": {"type": "boolean"}, "classification_required": {"type": "boolean"},
    "base": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "diff_range": {"type": "string", "minLength": 1},
    "staged_patch": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "tree_hash": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "semantic_expected_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_observed_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_graph_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/result"}},
    "validator_evidence": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "validator_code_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "in_scope_modules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["migration", "semantic", "incident", "docs", "topology", "classification", "workflow"]}},
    "review": {"type": "object", "additionalProperties": false, "required": ["path", "artifact_path", "sha256", "status", "scope_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "artifact_path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "status": {"const": "PASS"}, "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "origin": {"$ref": "#/$defs/origin"},
    "classification_result": {"type": "object"},
    "classification_input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "calibration_evidence": {"type": "object", "additionalProperties": false, "required": ["ledger", "calibration_predictions", "heldout_predictions"], "properties": {"ledger": {"$ref": "#/$defs/evidence"}, "calibration_predictions": {"$ref": "#/$defs/evidence"}, "heldout_predictions": {"$ref": "#/$defs/evidence"}}},
    "calibration_generation_files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "module_modes": {"type": "object", "minProperties": 1, "propertyNames": {"enum": ["migration", "semantic", "incident", "docs", "topology", "classification", "workflow"]}, "additionalProperties": {"const": "enforce"}},
    "generated_at": {"type": "string", "format": "date-time"}, "workflow_version": {"type": "string", "minLength": 1}
  },
  "allOf": [{"if": {"properties": {"classification_required": {"const": true}}, "required": ["classification_required"]}, "then": {"required": ["calibration_evidence", "calibration_generation_files", "classification_result", "classification_input_digest"]}}],
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "origin": {"type": "object", "additionalProperties": false, "required": ["schema_version", "unit", "review_path", "review_sha256", "review_scope_sha256", "base", "generated_at"], "properties": {"schema_version": {"const": 1}, "unit": {"type": "string", "minLength": 1}, "review_path": {"type": "string", "minLength": 1}, "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "review_scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "base": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "generated_at": {"type": "string", "format": "date-time"}}},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["module", "verdict", "rc", "digest"],
      "properties": {"module": {"enum": ["migration", "semantic", "incident", "docs", "topology", "classification", "workflow"]}, "verdict": {"enum": ["PASS", "FAIL", "STALE", "UNVERIFIED", "WARN", "N/A"]}, "rc": {"type": "integer", "enum": [0, 1, 2, 3, 130]}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reason": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "due": {"type": "string", "format": "date"}},
      "allOf": [
        {"if": {"properties": {"verdict": {"enum": ["PASS", "WARN", "N/A"]}}, "required": ["verdict"]}, "then": {"properties": {"rc": {"const": 0}}}},
        {"if": {"properties": {"verdict": {"enum": ["FAIL", "STALE"]}}, "required": ["verdict"]}, "then": {"properties": {"rc": {"enum": [1, 3]}}}},
        {"if": {"properties": {"verdict": {"const": "UNVERIFIED"}}, "required": ["verdict"]}, "then": {"properties": {"rc": {"const": 2}}}},
        {"if": {"properties": {"verdict": {"const": "N/A"}}, "required": ["verdict"]}, "then": {"required": ["reason", "owner", "due"]}}
      ]
    }
  }
}
