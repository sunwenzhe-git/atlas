{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas:runtime-topology:v1",
  "title": "Atlas static runtime topology adapter output",
  "type": "object", "additionalProperties": false,
  "required": ["category", "items", "source_files", "adapter_version", "coverage", "inputs"],
  "properties": {
    "category": {"const": "topology"},
    "items": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/item"}},
    "source_files": {"type": "array", "items": {"type": "string"}},
    "adapter_version": {"type": "string", "minLength": 1},
    "coverage": {"$ref": "#/$defs/coverage"}, "inputs": {"$ref": "#/$defs/inputs"}
  },
  "$defs": {
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["source_file", "line", "sha256"],
      "properties": {"source_file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["node", "id", "kind", "name", "namespace", "app", "image", "ports", "source_file", "line", "sha256"],
      "properties": {
        "node": {"const": true}, "id": {"type": "string", "pattern": "^[^:]+:[^:]+:[^:]+:[^:]+:[^:]*:[^:]+$"},
        "kind": {"enum": ["service", "database", "kong_service", "kong_route", "kong_plugin"]},
        "name": {"type": "string", "minLength": 1}, "namespace": {"type": ["string", "null"], "minLength": 1},
        "app": {"type": ["string", "null"]}, "image": {"type": ["string", "null"]},
        "ports": {"type": "array", "items": {"type": ["integer", "string"]}},
        "source_file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["edge", "id", "kind", "from", "to", "relation", "source_file", "line", "sha256"],
      "properties": {
        "edge": {"const": true}, "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
        "kind": {"enum": ["depends_on", "routes_to", "upstream", "plugin", "network"]},
        "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1}, "port": {"type": ["integer", "string", "null"]},
        "source_file": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "item": {"oneOf": [{"$ref": "#/$defs/node"}, {"$ref": "#/$defs/edge"}]},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["parsed", "unverified_fields", "parse_errors"],
      "properties": {
        "parsed": {"type": "integer", "minimum": 0},
        "unverified_fields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "fields", "owner", "due"], "properties": {"id": {"type": "string"}, "source_file": {"type": "string", "minLength": 1}, "fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "owner": {"type": "string", "minLength": 1}, "due": {"type": "string", "format": "date"}}}},
        "parse_errors": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "message"], "properties": {"path": {"type": "string"}, "message": {"type": "string"}}}}
      }
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "environment", "cluster", "release", "scan_globs"],
      "properties": {
        "project": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1}, "release": {"type": "string", "minLength": 1},
        "scan_globs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
